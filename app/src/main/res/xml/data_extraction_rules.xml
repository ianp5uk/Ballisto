<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the database file may move to a new phone with device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="ballisto_db.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="ballisto_db.json" />
    </device-transfer>
</data-extraction-rules>
